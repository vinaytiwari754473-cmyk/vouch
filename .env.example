# The committed demo defaults to replay and needs no secrets.
VOUCH_AI_MODE=replay

# Live capture is explicit optional development tooling; demo never reads these values.
# CLI subscription providers need no API key:
# VOUCH_MODEL_ID=gpt-5.6-sol

# Direct HTTP providers are also supported. Keep real keys only in .env.local.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOUCH_PROMPT_VERSION=vouch-investigator/1
